# Copy to frontend/.env for `npm run dev`.

# Supabase project (Project settings → API). The anon key is public by design;
# access is enforced by Row Level Security.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API base URL used in development (production builds call /api on the same origin)
VITE_API_URL=http://localhost:3001/api
