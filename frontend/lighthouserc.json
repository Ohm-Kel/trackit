{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --port 4180 --strictPort --host 127.0.0.1",
      "startServerReadyPattern": "Local",
      "url": ["http://127.0.0.1:4180/landing"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "skipAudits": ["errors-in-console"]
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1 }],
        "categories:seo": ["error", { "minScore": 1 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 3200 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 300 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 204800 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 25600 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 307200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
