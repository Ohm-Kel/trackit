# Copy to .env at the repository root for `docker compose up`.
# Compose passes these to the frontend build; the API reads backend/.env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional public origin for canonical and social-card URLs
# (defaults to https://trackit-app-smoky.vercel.app).
# VITE_SITE_URL=http://localhost:8080
