{
  "name": "trackit-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "eval": "node eval/run.js"
  },
  "author": "Semanu Kwaku Sebuava",
  "license": "MIT",
  "description": "Express API for Trackit, the AI-powered student deadline tracker",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@supabase/supabase-js": "^2.99.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pdfkit": "^0.20.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "**/*.js",
      "!**/node_modules/**",
      "!coverage/**",
      "!eval/**",
      "!tests/**",
      "!eslint.config.js",
      "!server.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85
      }
    }
  }
}
