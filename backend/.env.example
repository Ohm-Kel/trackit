# Copy to backend/.env and fill in. Never commit the real file.

# Supabase project (Project settings → API). The service role key bypasses
# Row Level Security: keep it server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Anthropic API (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional: override the model used for chat and timetable parsing
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Comma-separated origins allowed to call the API cross-origin
ALLOWED_ORIGINS=http://localhost:5173
PORT=3001

# Optional tuning (defaults shown)
# LOG_LEVEL=info
# RATE_LIMIT_STORE=supabase   # or memory (per process)
# AI_RATE_LIMIT_WINDOW_MS=3600000
# AI_CHAT_RATE_LIMIT=30
# AI_UPLOAD_RATE_LIMIT=10
# CHAT_MAX_HISTORY_MESSAGES=20
# CHAT_MAX_MESSAGE_CHARS=4000
